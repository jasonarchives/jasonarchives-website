    {
      "id": "DES-01",
      "label": "Creatives for Collectives",
      "desc": "Assisting in content creation with both physical and digital media for Local Threads Collective.",
      "group": "record",
      "url": "/designrec/DES-01.html"
    },
    {
      "id": "DES-02",
      "label": "Reimagining a Duty-Free Experience",
      "desc": "Reimagining duty-free shopping for post-pandemic Gen Z travelers. Mapped mobile-first customer journeys blending physical and digital retail.",
      "group": "record",
      "url": "/designrec/DES-02.html"
    },
    {
      "id": "DES-03",
      "label": "Bicycle Parking at Uppsala Centralstation",
      "desc": "Fixing a confusing check-in/out system causing severe user friction through iterative, participatory design co-created with commuters.",
      "group": "record",
      "url": "/designrec/DES-03.html"
    },
    {
      "id": "DES-04",
      "label": "Journey Mapping with Hunters",
      "desc": "Understanding user behaviour and visualising key findings through mixed methods research to guide UX decisions at GAIM.",
      "group": "record",
      "url": "/designrec/DES-04.html"
    },
    {
      "id": "DES-05",
      "label": "OST & Manual Redesign",
      "desc": "Turning UX Research into concrete business strategy and implementing a pilot project. Documented a new UX Strategy and redesigned the core User Manual.",
      "group": "record",
      "url": "/designrec/DES-05.html"
    },
    {
      "id": "PHO-01",
      "label": "Midnight in Uppsala",
      "desc": "Two years of midnight adventures in Uppsala. An exploration of celestial lights, city streets, and finding warmth.",
      "group": "record",
      "url": "/photorec/PHO-01.html"
    },
    {
      "id": "PHO-02",
      "label": "Expressions at 8mm",
      "desc": "My journey capturing human expressions with the Samyang 8mm Wide-Angle lens.",
      "group": "record",
      "url": "/photorec/PHO-02.html"
    },
    {
      "id": "PHO-03",
      "label": "Under the Sun",
      "desc": "An exploration of how the Sun became a silent participant in my photography.",
      "group": "record",
      "url": "/photorec/PHO-03.html"
    },
    {
      "id": "localthreadscollective",
      "label": "Local Threads Collective",
      "desc": "Becoming a part of a much-needed slow moving community in Mumbai",
      "group": "record",
      "url": "/communityrec/localthreadscollective.html"
    },
    {
      "id": "vdalanation",
      "label": "Västmanlands Dalarna Nation",
      "desc": "A space where I found friendships, discovered new skills and spent most of my time while living as a student in Uppsala.",
      "group": "record",
      "url": "/communityrec/vdalanation.html"
    },
    {
      "id": "WRT-01",
      "label": "Slowing Down with Resistance",
      "desc": "In Mumbai’s Sanjay Gandhi National Park, Local Threads Collective gathered for a simple picnic—unstructured, slow, and free of agenda. Leisure here became resistance...",
      "group": "record",
      "url": "https://medium.com",
      "external": true
    },
    {
      "id": "WRT-02",
      "label": "A Seat on Skåne Expressen",
      "desc": "On SkåneExpressen Buss 15, nightly rides from Malmö to Vellinge turned routine into quiet beauty. Fields, bridges, and fleeting dawns became the memories that lingered.",
      "group": "record",
      "url": "https://medium.com",
      "external": true
    },
    {
      "id": "WRT-03",
      "label": "Finding Threads among Fraying Tapestries",
      "desc": "Organising events and leading teams in Photography & Graphic Design while studying at SFIT Mumbai.",
      "group": "record",
      "url": "https://medium.com",
      "external": true
    },
    {
      "id": "WRT-04",
      "label": "Inside Puben",
      "desc": "At Puben in Uppsala’s “White Castle”, bartending turned into fieldwork. Cheap drinks, karaoke, and shared rituals revealed a space of belonging woven from everyday moments.",
      "group": "record",
      "url": "https://medium.com",
      "external": true
    },
    {
      "id": "WRT-05",
      "label": "Humans, Cameras and Experience - An Essay",
      "desc": "Over years of use, my camera shifted from tool to extension of myself. Through touch, sight, and emotion, it shaped how I experienced the world. It is no longer just equipment.",
      "group": "record",
      "url": "https://medium.com",
      "external": true
    },
